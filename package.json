{
  "name": "konzendi",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "repository": "github:torlenor/konzendi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "notices": "node scripts/third-party-notices.mjs",
    "logo:export": "node scripts/logo-export.mjs",
    "logo:icons": "node scripts/logo-export.mjs --app-icons",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4"
  }
}
